    {
      "id": "y2-mar-kongtong-life",
      "year": 2,
      "month": 3,
      "title": "崆峒日常與設施",
      "trigger": "timed",
      "routeIds": [
        "kongtong-study"
      ],
      "preconditions": [
        {
          "kind": "time",
          "text": "第二年三月上旬起"
        },
        {
          "kind": "choice",
          "text": "選擇崆峒留學"
        }
      ],
      "options": [
        {
          "id": "o1",
          "text": "窩居",
          "preconditions": [],
          "consequence": {
            "summary": "回復心相；偶有比武切磋；名聲 40 以上的「別派觀望」事件中，選打死你可 roll 出宋兵並得《楊家練兵操》，戰敗為 be14。"
          }
        },
        {
          "id": "o2",
          "text": "無色廣場（逛街／賭場／擂臺）",
          "preconditions": [],
          "consequence": {
            "summary": "逛街花 300 銀兩隨機加小梅或小竹好感，遇四師兄 +100 心相；賭場成功 +1000、大成功 +3000、失敗 -1000，贏到 5000 會被搶劫，不給錢則戰鬥（be13）；擂臺輸為 be14，贏得銀兩與武學點，連贏 3 次以上額外加嘴力、學問、內力。"
          }
        },
        {
          "id": "o3",
          "text": "飛天殿",
          "preconditions": [],
          "consequence": {
            "summary": "練功額外 +1 輕功；吹牛達人場所大量扣好感，吹牛 5 次得風雲史「煩人修仙」，也可能被火龍仙君噴死（be15）。3DM 另稱此處訓練可能觸發死法「自食惡果」。"
          }
        },
        {
          "id": "o4",
          "text": "鐵拳巷",
          "preconditions": [],
          "consequence": {
            "summary": "練功額外 +1 體力，大成功有機會加小竹好感；可升級裝備；連續進入 2 次會初識小竹，戰敗為 be16「被情敵殺死」。"
          }
        },
        {
          "id": "o5",
          "text": "玄功洞",
          "preconditions": [],
          "consequence": {
            "summary": "練功額外 +1 拳腳，讀書加學問、回心相；讀小說、詩詞、古文達一定次數會觸發魏掌門事件。"
          }
        },
        {
          "id": "o6",
          "text": "奪魄峰／奪魄森林",
          "preconditions": [],
          "consequence": {
            "summary": "奪魄峰練功額外 +1 暗器，下棋加學問、性情、修養；奪魄森林（拜夏侯蘭後開啟）練功隨機加拳腳、刀劍、體力。"
          }
        }
      ],
      "sources": [
        {
          "site": "巴哈姆特",
          "url": "https://forum.gamer.com.tw/C.php?bsn=73317&snA=1939",
          "version": "未標示",
          "date": "2024-08-24"
        },
        {
          "site": "3DM",
          "url": "https://www.3dmgame.com/gl/3941109_21.html",
          "version": "未標示",
          "date": "2024-08-19"
        }
      ]
    },
