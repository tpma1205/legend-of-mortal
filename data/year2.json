    {
      "id": "y2-mar-sect-lottery",
      "year": 2,
      "month": 3,
      "title": "初識魏菊、抽選門派",
      "trigger": "timed",
      "routeIds": [
        "kongtong-study",
        "xiahoulan",
        "xiaomei"
      ],
      "preconditions": [
        {
          "kind": "time",
          "text": "第二年三月上旬"
        },
        {
          "kind": "choice",
          "text": "選擇崆峒留學"
        }
      ],
      "options": [
        {
          "id": "o1",
          "text": "抽選門派（隨機決定入門）",
          "preconditions": [],
          "consequence": {
            "summary": "依 roll 點分配門派：<25 鐵拳門（學鐵臂神拳）、<50 玄功門（三選一：飛天腳／無影爪／鐵臂神拳）、<75 奪魄門、>=75 飛天門。選項會影響魏菊、小梅、小竹、高木等人好感。",
            "alternatives": [
              {
                "summary": "另一來源寫入門秘笈：飛天門得《飛天腳》、鐵拳門得《十八種奇兵鍛法雜記》、奪魄門得《無影爪》；玄功門三選一，之後魏掌門補送未選的一本。夏侯蘭線只能選奪魄門；飛天門有小梅劇情，鐵拳門有小竹劇情，玄功門劇情最多。",
                "source": {
                  "site": "巴哈姆特",
                  "url": "https://forum.gamer.com.tw/C.php?bsn=73317&snA=1939",
                  "version": "未標示",
                  "date": "2024-08-24"
                }
              }
            ]
          }
        }
      ],
