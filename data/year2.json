    {
      "id": "y2-feb-study-choice",
      "year": 2,
      "month": 2,
      "title": "唐門例會：討論留學",
      "trigger": "timed",
      "routeIds": [
        "kongtong-study",
        "stay-tangmen"
      ],
      "preconditions": [
        {
          "kind": "time",
          "text": "第二年二月上旬，唐門例會"
        }
      ],
      "options": [
        {
          "id": "o1",
          "text": "去崆峒派留學",
          "preconditions": [
            {
              "kind": "stat",
              "text": "貢獻至少 80"
            }
          ],
          "consequence": {
            "summary": "進入崆峒留學線。需扣 50 貢獻，例會本身另扣 30 貢獻，開會前至少要有 80 貢獻，不足就不能選留學；選擇後銀兩-1000、唐惟元好感上升。夏侯蘭線需此時選留學。",
            "statChanges": [
              {
                "stat": "貢獻",
                "delta": -50
              },
              {
                "stat": "銀兩",
                "delta": -1000
              }
            ],
            "unlocks": [
              "崆峒留學線",
              "夏侯蘭線（需入奪魄門）"
            ],
            "misses": [
              "留守唐門線"
            ]
          }
        },
        {
          "id": "o2",
          "text": "留在唐門",
          "preconditions": [],
          "consequence": {
            "summary": "進入留守唐門線，趙活之後會不辭而別離開唐門並觸發相關事件（遊俠網）。",
            "unlocks": [
              "留守唐門線"
            ],
            "misses": [
              "崆峒留學線"
            ]
          }
        }
      ],
